# Copy to .env and fill in what you use. Everything except Supabase is optional:
# features whose keys are missing are simply unavailable.
# Per-user API keys (ElevenLabs, Groq, Vibi, ...) are entered in the app's Settings page, not here.

# ---- Server ----
PORT=3000
NODE_ENV=development
# Extra CORS origins, comma separated (localhost is always allowed)
ALLOWED_ORIGINS=
# Public URL of the app (used in links); leave empty locally
APP_URL=
# Backend URL for the frontend; leave empty locally (Vite proxies /api)
VITE_API_URL=

# ---- Supabase (auth + database) ----
# Create a project at https://supabase.com, then run the SQL in supabase/migrations/.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- S3 storage (optional; videos are kept locally without it) ----
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_BACKGROUND_VIDEO_MB=

# ---- Background gameplay clips ----
# Short-form clips (default backend/public/background-videos)
BACKGROUND_CLIPS_DIR=
# Long-form 16:9 clips (default backend/public/background-videos-16x9) and S3 prefix
LANDSCAPE_CLIPS_DIR=
LANDSCAPE_CLIPS_PREFIX=
# Long vertical clips for long-form promo shorts
PROMO_CLIPS_DIR=

# ---- Local renderer tuning (optional; see docs/feature-tracking/rendering/local-renderer.md) ----
FFMPEG_PATH=
FFPROBE_PATH=
RENDER_CONCURRENCY=
RENDER_ENCODER=
RENDER_HWACCEL=

# ---- Text-to-speech ----
ELEVENLABS_MODEL_ID=eleven_v4
# Local Pocket TTS / Whisper server (backend/local-tts/start.sh), default http://localhost:3910
LOCAL_TTS_URL=
LOCAL_TTS_API_KEY=
# Fish Drama 3 on Modal (backend/cloud-tts/fish_drama.py)
FISH_DRAMA_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
# Vibi TTS overrides
VIBI_API_URL=
VIBI_PROVIDER=
VIBI_MODEL_ID=
# Groq speech-to-text model
GROQ_STT_MODEL=

# ---- Research page / third-party APIs (optional) ----
SCRIPZ_API_KEY=
VIEWSTATS_BEARER_TOKEN=
VIEWSTATS_IV_B64=
VIEWSTATS_KEY_B64=
TRENDY_BOT_API_URL=
TRENDY_BOT_API_KEY=
SLICR_API_URL=
SLICR_API_KEY=

# ---- Telegram delivery (optional) ----
TELEGRAM_BOT_TOKEN=

# ---- Remotion Lambda rendering (legacy, optional) ----
USE_LAMBDA_RENDERING=false
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_ROLE_ARN=
REMOTION_AWS_BUCKET_NAME=
REMOTION_SERVE_URL=
REMOTION_FUNCTION_NAME=
REMOTION_MAX_FUNCTIONS=
